{
  "expo": {
    "name": "LocalUp",
    "slug": "localup-app",
    "scheme": "localup-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#653FD4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kallinikosmil.localup"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#653FD4"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kallinikosmil.localup",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#653FD4"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7eb2ddc2-c55b-4ea5-9010-811c1049a8f7"
      }
    },
    "owner": "drumber",
    "updates": {
      "url": "https://u.expo.dev/7eb2ddc2-c55b-4ea5-9010-811c1049a8f7"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
