# Copy this file to `.env` and fill in your Supabase project's values.
# Supabase dashboard → Project Settings → API.
#
# These are EXPO_PUBLIC_* so they're bundled into the client app. That's fine:
# the anon key is meant to be public — access is enforced by Row-Level Security.
# NEVER put the service_role key in here or in any client-side file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
