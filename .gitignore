# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# NOT ignored: .prettierrc and tsconfig.json. Both carry project rules —
# strict mode, the path aliases, the style CLAUDE.md documents — and
# neither holds anything machine-specific. Ignoring them meant a fresh
# clone could not run npm run verify.

#Enviroment variables
.env

# Local assistant notes
agents.md
.mcp.json
CLAUDE.md
SUPABASE_SETUP.md
.env.example

# Internal planning docs & local overview (kept out of the public repo)
docs/superpowers/
LOCALUP_OVERVIEW.md
.claude/

# Security notes naming the live project (never publish)
SECURITY-FIX-*.md

# Supabase CLI local state
supabase/.temp/

# Firebase — the Android app it identifies is this repo, and the file
# carries project identifiers. Public repo: keep it out.
google-services.json
GoogleService-Info.plist

# Firebase admin service account: can send push to any device. Never commit.
fcm-service-account.json
*-firebase-adminsdk-*.json

# Vendored agent skills — tooling, not app source, and the repo is public.
.agents/
skills-lock.json
